# 법제처 Open API 인증키 (필수 for live law lookup)
# 발급: https://open.law.go.kr/LSO/openApi/guideList.do
LAW_OC=

# 공공데이터포털 일반 인증키 (KOSHA GUIDE Open API)
# 발급: https://www.data.go.kr/data/15144147/openapi.do
DATA_GO_KR_KEY=

# LLM (하나 이상 설정 — 없으면 demo 모드로 동작)
# Gemini 권장 (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 선택: OpenAI 폴백
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 서버
HOST=0.0.0.0
PORT=8787
DEMO_MODE=auto
# auto | true | false
# auto: LAW_OC 없으면 demo 조문, LLM 키 없으면 템플릿 답변

# (보통 비움) 관리(키 저장·PDF 업로드)는 기본으로 로컬(이 컴퓨터)에서만 됨.
# 원격에서도 관리하려면 긴 비밀을 넣고 헤더 X-Admin-Token 사용.
# ADMIN_TOKEN=

# 캐시 TTL (초)
CACHE_ARTICLE_TTL=86400
CACHE_SEARCH_TTL=3600
